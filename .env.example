# ────────────────────────────────────────────────────────────
# AI Document Intake Pipeline — Environment Configuration
# Copy to .env and fill in values. Never commit real keys.
# ────────────────────────────────────────────────────────────

# ── LLM Provider ────────────────────────────────────────────
# Provider: "mock" (default, zero cost) or "openai" (OpenAI-compatible API)
LLM_PROVIDER=mock

# OpenAI-compatible settings (only needed if LLM_PROVIDER=openai)
# Example: https://api.openai.com/v1  or  https://openrouter.ai/api/v1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# ── Database ────────────────────────────────────────────────
# Postgres in Docker Compose:
DATABASE_URL=postgresql+psycopg://docintake:docintake@localhost:5432/docintake

# For local testing without Docker (sqlite):
# DATABASE_URL=sqlite:///./docintake.db

# ── API ─────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Routing / Notification ──────────────────────────────────
# Webhook stub for routed document notifications (optional)
NOTIFY_WEBHOOK_URL=

# ── Prefect ─────────────────────────────────────────────────
PREFECT_API_URL=
